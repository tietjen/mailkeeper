    "Mails, die dieser inhaltlich ähneln – die ähnlichsten zuerst": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail similar in content to this one – the most similar first"
          }
        }
      }
    },
    "Mails, die nur noch im Archiv liegen, wieder auf einen Server hochladen; vorher kommt eine Übersicht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload mail that lies only in the archive back onto a server; the plan comes first"
          }
        }
