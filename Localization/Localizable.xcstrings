    },
    "Einrichtung starten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Setup"
          }
        }
      }
    },
    "Einrichtung …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
