    "%lld Mails über 10 MB, älter als ein Jahr – zusammen %@; %@. Vom Server löschen kostet nichts, das Archiv behält sie; aus dem Archiv gelöscht sind sie nach 30 Tagen endgültig weg – nur, wenn du die Anhänge nirgends brauchst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld Mails über 10 MB, älter als ein Jahr – zusammen %2$@; %3$@. Vom Server löschen kostet nichts, das Archiv behält sie; aus dem Archiv gelöscht sind sie nach 30 Tagen endgültig weg – nur, wenn du die Anhänge nirgends brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mails over 10 MB, older than a year – %@ together; %@. Deleting them on the server costs nothing, the archive keeps them; deleted from the archive they are gone for good after 30 days – only do that if you need the attachments nowhere."
          }
        }
      }
    },
    "%lld Mails, %lld %% ungelesen, die letzte am %@; %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
