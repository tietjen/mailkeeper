    },
    "Eingrenzung aufheben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the narrowing"
          }
        }
      }
    },
    "Einordnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classify"
          }
        }
      }
    },
    "Einrichtung": {
