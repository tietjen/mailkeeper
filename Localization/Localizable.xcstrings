          }
        }
      }
    },
    "Endpoint nicht erreichbar: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint not reachable: %@"
          }
        }
      }
    },
    "Endpoint pausiert nach einem Fehler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The endpoint is paused after an error"
          }
        }
      }
    },
    "Entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "Entfernen (Anmeldung bleibt, anderes Konto nutzt sie)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove (the sign-in stays, another account uses it)"
          }
        }
      }
    },
    "Entfernen und Google-Anmeldung widerrufen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove and revoke the Google sign-in"
          }
        }
      }
    },
    "Entfernen und Passwort löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove and delete the password"
          }
        }
      }
    },
    "Entfernen, Passwort behalten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove, keep the password"
          }
        }
      }
    },
    "Entfernen, angemeldet bleiben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove, stay signed in"
          }
        }
      }
    },
    "Entscheidend ist, wem geglaubt wird: Die Prüfergebnisse in einer Mail zählen nur, wenn dein eigener Server sie geschrieben hat. Jeder kann „dmarc=pass“ hineinschreiben — auch der Angreifer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What matters is whom you believe: the check results in a mail count only if your own server wrote them. Anyone can put “dmarc=pass” in there — the attacker too."
          }
        }
      }
    },
    "Erledigt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Erneut anmelden …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In Again…"
          }
        }
      }
    },
    "Erneut versuchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "Erst die Adresse des Endpoints eintragen – der Schlüssel gehört zu ihr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the endpoint's address first – the key belongs to it."
          }
        }
      }
    },
    "Erst die Adresse eintragen – der Schlüssel gehört zu ihr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the address first – the key belongs to it."
          }
        }
      }
    },
    "Erst ein Archiv anlegen oder öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create or open an archive first"
          }
        }
      }
    },
    "Erst ein Archiv anlegen: Hilfe › Einrichtung …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an archive first: Help › Setup…"
          }
        }
      }
    },
    "Erst ein Konto anlegen: Einstellungen › Konten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up an account first: Settings › Accounts"
          }
        }
      }
    },
    "Erst mindestens 10 Mails labeln": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label at least 10 mails first"
          }
        }
      }
    },
    "Erst wenn Import oder Abruf fertig sind, lässt sich das Archiv wechseln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive can only be switched once the import or fetch has finished."
          }
        }
      }
    },
    "Erst wenn die laufende Aktion fertig ist (oder mit × anhalten)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only once the running action has finished (or stop it with ×)"
          }
        }
      }
    },
    "Erst wenn die laufende Aktion fertig oder angehalten ist (× in der Statusleiste)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only once the running action has finished or been stopped (× in the status bar)"
          }
        }
      }
    },
    "Erste Mail von dieser Adresse im Archiv.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first mail from this address in the archive."
          }
        }
      }
    },
    "Erstkontakt an deine öffentliche Adresse %@: unaufgefordert. Name oder Firma in der Mail sind kein Echtheitsbeweis – aber auch kein Spam-Beweis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First contact at your public address %@: unsolicited. A name or a company in the mail proves nothing about authenticity – and nothing about spam either."
          }
        }
      }
    },
    "Erzeugen unter Google-Konto › Sicherheit › 2-Schritt-Verifizierung › App-Passwörter. Google zeigt es nur einmal; die Leerzeichen darfst du mitkopieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create it under Google Account › Security › 2-Step Verification › App passwords. Google shows it only once; you may copy the spaces along with it."
          }
        }
      }
    },
    "Es fehlt noch: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still missing: %@"
          }
        }
      }
    },
    "Es gibt keinen Cloud-Anbieter. Entweder ein Endpunkt, den du selbst betreibst (LiteLLM, Ollama, LM Studio), oder das Modell auf diesem Mac — oder gar keins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no cloud provider. Either an endpoint you run yourself (LiteLLM, Ollama, LM Studio), or the model on this Mac — or none at all."
          }
        }
      }
    },
    "Etwas, das MailKeeper wissen soll, z. B. „Mails vom Steuerberater sind wichtig“": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something MailKeeper should know, for example “mail from the accountant is important”"
          }
        }
      }
    },
    "Export abgebrochen; die schon geschriebenen Dateien bleiben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export stopped; the files already written stay."
          }
        }
      }
    },
    "Export abgebrochen; es ist keine mbox-Datei entstanden, eine ersetzte bleibt wie sie war.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export stopped; no mbox file was created, and one being replaced stays as it was."
          }
        }
      }
    },
    "Export fertig": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export finished"
          }
        }
      }
    },
