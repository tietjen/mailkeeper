    "Aus dem Archiv entfernen – nicht rückgängig zu machen; vorher kommt eine Übersicht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from the archive – cannot be undone; the plan comes first"
          }
        }
      }
    },
    "Aus dem Archiv löschen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete from the archive"
          }
        }
      }
    },
    "Aus dem Archiv löschen …": {
      "localizations": {
