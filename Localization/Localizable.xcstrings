        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mails, %lld %% unread, the last on %@; %@."
          }
        }
      }
    },
    "%lld Mails, die auf keinem Server mehr liegen, in den Papierkorb des Archivs – nach 30 Tagen endgültig weg; vorher kommt die Übersicht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
