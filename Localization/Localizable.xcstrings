            "value": "Your gold set"
          }
        }
      }
    },
    "Dein Urteil gilt für diese Mail und überdauert jede neue Einschätzung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your verdict holds for this mail and outlasts every new assessment."
          }
        }
      }
    },
