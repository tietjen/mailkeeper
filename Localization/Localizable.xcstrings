    "%lld Mails im Spam-Ordner, älter als 30 Tage, die eine KI oder du als Spam oder Phishing bewertet hat; %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld Mails im Spam-Ordner, älter als 30 Tage, die eine KI oder du als Spam oder Phishing bewertet hat; %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mails in the spam folder, older than 30 days, judged spam or phishing by an AI or by you; %@."
          }
        }
      }
    },
    "%lld Mails in den Papierkorb ihres Servers – das Archiv behält sie; vorher kommt die Übersicht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mails into their server's trash – the archive keeps them; the plan comes first"
          }
        }
      }
    },
