    },
    "Filter zur Suche hinzufügen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a filter to the search"
          }
        }
      }
    },
    "Format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Format"
          }
        }
      }
    },
    "Freigegeben: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available: %@"
          }
        }
      }
    },
    "Für Konto „%@“ fehlt die Google-Client-ID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Google client ID is missing for the account “%@”"
          }
        }
      }
    },
    "Für Konto „%@“ ist kein Passwort im Schlüsselbund": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no password in the keychain for the account “%@”"
          }
        }
      }
    },
    "Für Konto „%@“ ist keine Google-Anmeldung im Schlüsselbund – bitte neu anmelden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no Google sign-in in the keychain for the account “%@” – please sign in again"
          }
        }
      }
    },
    "Für diese Client-ID liegt auf diesem Mac kein Clientschlüssel – bitte eintragen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no client secret for this client ID on this Mac – please enter it."
          }
        }
      }
    },
    "Für diese Gruppe künftig: Art festlegen, nach Tagen vom Server löschen oder in den Spam-Ordner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this group from now on: set the kind, delete from the server after so many days, or move into the spam folder"
          }
        }
      }
    },
    "Für diese Mail gibt es noch keinen Vektor – die Embeddings laufen im Hintergrund (Statusleiste).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no vector for this mail yet – the embeddings are running in the background (status bar)."
          }
        }
      }
    },
    "Für eine belastbare Zahl: etwa 80 Mails – je Absender eine, über alle Arten und den Spam-Ordner verteilt. MailKeepers eigene Einordnung bleibt beim Labeln verborgen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a number you can rely on: about 80 mails – one per sender, spread over every kind and the spam folder. MailKeeper's own classification stays hidden while you label."
          }
        }
      }
    },
    "GOCSPX-…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GOCSPX-…"
          }
        }
      }
    },
    "Ganze Konversation in der Liste zeigen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the whole conversation in the list"
          }
        }
      }
    },
    "Gedächtnis": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory"
          }
        }
      }
    },
    "Gelesen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read"
          }
        }
      }
    },
    "Gemeint ist „on:server“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You mean “on:server”."
          }
        }
      }
    },
    "Gemeint ist „only:archive“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You mean “only:archive”."
          }
        }
      }
    },
    "Gerade läuft „%@“ – Abrufen geht danach (oder mit × anhalten).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is running – fetching works afterwards (or stop it with ×)."
          }
        }
      }
    },
    "Gerade läuft „%@“ – bitte danach noch einmal (oder mit × anhalten).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is running – please try again afterwards (or stop it with ×)."
          }
        }
      }
    },
    "Gerade läuft „%@“. Das Archiv lässt sich wechseln, sobald sie fertig ist – oder halte sie mit × unten in der Statusleiste an; was fertig ist, bleibt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is running. The archive can be switched once it has finished – or stop it with the × at the bottom of the status bar; what is done stays done."
          }
        }
      }
    },
    "Gesendet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        }
      }
    },
    "Gesichert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved"
          }
        }
      }
    },
    "Gespeicherte Suche": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved search"
          }
        }
      }
    },
    "Gespeicherte Suche: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved search: %@"
          }
        }
      }
    },
    "Gezählt wird ab dem Eingang auf dem Server, nicht ab dem Datum der Mail. Eine alte Mail, die erst kürzlich hochgeladen wurde (Umzug, Import), ist dort neu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted from when it arrived on the server, not from the date of the mail. An old mail uploaded recently (a move, an import) is new there."
          }
        }
      }
    },
    "Geändert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed"
          }
        }
      }
    },
    "Gibt sich als „%@“ aus, kommt aber von %@ – %@ schreibt von %@.": {
      "comment": "look-alike",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Gibt sich als „%1$@“ aus, kommt aber von %2$@ – %3$@ schreibt von %4$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claims to be “%@” but comes from %@ – %@ writes from %@."
          }
        }
      }
    },
    "Gilt in jedem Konto, in dem die Mail liegt: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies in every account the mail lies in: %@."
          }
        }
      }
    },
    "Gmail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail"
          }
        }
      }
    },
    "Gmail geht auf zwei Wegen: mit App-Passwort (schnell, braucht die 2-Schritt-Verifizierung) oder mit Anmeldung über Google (braucht einmalig einen eigenen Google-Client – der Dialog führt in vier Schritten hindurch und verlinkt jede Seite bei Google). Passwörter und Anmeldungen liegen im Schlüsselbund, nie im Archiv.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail works two ways: with an app password (quick, needs 2-Step Verification) or by signing in with Google (needs a Google client of your own, once – the dialog walks you through it in four steps and links every page at Google). Passwords and sign-ins live in the keychain, never in the archive."
          }
        }
      }
    },
    "Google": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google"
          }
        }
      }
    },
    "Google antwortete: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google answered: %@"
          }
        }
      }
    },
    "Google hat die Anmeldung abgelehnt: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google refused the sign-in: %@"
          }
        }
      }
    },
    "Google hat keinen Anmelde-Code zurückgegeben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google returned no sign-in code"
          }
        }
      }
    },
    "Google-Konto › Sicherheit › 2-Schritt-Verifizierung › App-Passwörter. Die Google-Anmeldung bleibt im Schlüsselbund stehen — ein anderes Archiv könnte sie noch nutzen; widerrufen wird sie bei Google unter „Verbundene Apps“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Account › Security › 2-Step Verification › App passwords. The Google sign-in stays in the keychain — another archive might still use it; revoke it at Google under “Connected apps”."
          }
        }
      }
    },
    "Große alte Mails": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large old mails"
          }
        }
      }
    },
    "Gruppen auf diese Mails eingrenzen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrow the groups to these mails"
          }
        }
      }
    },
    "Größe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        }
      }
    },
    "Größer als 5 MB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Larger than 5 MB"
          }
        }
      }
    },
    "Größte Gruppen nach Speicher": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Largest groups by storage"
          }
        }
      }
    },
    "Gründe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasons"
          }
        }
      }
    },
    "HTTP geht nur für localhost und .ziti-Adressen – sonst bitte HTTPS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP only works for localhost and .ziti addresses – otherwise please use HTTPS"
          }
        }
      }
    },
    "Handbuch öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the handbook"
          }
        }
      }
    },
    "Handbuch öffnen …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Handbook…"
          }
        }
      }
    },
    "Herkunft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin"
          }
        }
      }
    },
    "Hier sichern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save here"
          }
        }
      }
    },
    "Hier stehen alle Nachrichten, deine gespeicherten Ansichten und — sobald ein Konto eingerichtet ist — seine Ordner. „Spam-Prüfung“ und „Verdächtig“ sammeln, was einen zweiten Blick verdient.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here are all messages, your saved views and — once an account is set up — its folders. “Spam check” and “Suspicious” collect what deserves a second look."
          }
        }
      }
    },
    "Hier stehen alle Nachrichten, der Papierkorb, „Verdächtig“ — und, sobald du eines eingerichtet hast, jedes Konto mit seinen Ordnern. Gespeicherte Suchen landen als eigene Ansicht darüber.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here are all messages, the trash, “Suspicious” — and, once you have set one up, every account with its folders. Saved searches appear as views of their own above them."
          }
        }
      }
    },
    "Hinweis": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note"
          }
        }
      }
    },
    "Hinweis für die KI merken": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember a note for the AI"
          }
        }
      }
    },
    "Hinweise zu Erledigten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes on what was done"
          }
        }
      }
    },
    "Hinzufügen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "Holt die Mails aller Konten dieses Archivs, nur lesend. Der erste Abruf lädt alles und kann dauern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches the mail of every account in this archive, read-only. The first fetch loads everything and can take a while."
          }
        }
      }
    },
    "I/O error (%@) at %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "I/O error (%1$@) at %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I/O error (%@) at %@"
          }
        }
      }
    },
    "IMAP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IMAP"
          }
        }
      }
    },
    "Im Archiv abgelegt, auf dem Server nicht: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filed in the archive, not on the server: %@"
          }
        }
      }
    },
    "Im Archiv abgelegt. Auf dem Server ist nichts zu tun.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filed in the archive. There is nothing to do on the server."
          }
        }
      }
    },
    "Im Archiv abgelegt. Auf dem Server nichts zu tun: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filed in the archive. Nothing to do on the server: %@"
          }
        }
      }
    },
    "Im Archiv gelöscht: Auf dem Server ändert sich nichts. Was noch auf einem Server liegt, lässt sich nicht aus dem Archiv löschen – es käme beim nächsten Abruf wieder; der Plan bietet an, es zuerst dort zu löschen. Der Papierkorb des Archivs hält 30 Tage, und endgültig Gelöschtes holt kein Abruf zurück.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted in the archive: nothing changes on the server. Mail that still lies on a server cannot be deleted from the archive — the next fetch would bring it back; the plan offers to delete it there first. The archive's trash keeps mail for 30 days, and no fetch brings back what was deleted for good."
          }
        }
      }
    },
    "Im Browser warnt Google „Google hat diese App nicht überprüft“ – bei deinem eigenen Client normal, weiter über „Erweitert“. Google fragt nach vollem Gmail-Zugriff, weil IMAP keinen kleineren kennt; MailKeeper ändert nur etwas, wenn du eine Aktion startest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the browser, Google warns “Google hasn’t verified this app” – normal for your own client; continue via “Advanced”. Google asks for full Gmail access because IMAP knows no narrower one; MailKeeper only changes something when you start an action."
          }
        }
      }
    },
    "Im Finder zeigen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    },
    "Im Hintergrund": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the background"
          }
        }
      }
    },
    "Im Ordner der App unter ~/Library/Containers. Genügt zum Ausprobieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app's folder under ~/Library/Containers. Enough to try things out."
          }
        }
      }
    },
    "Im Papierkorb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the trash"
          }
        }
      }
    },
    "Im Papierkorb liegt nur, was auf keinem Server mehr ist": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what lies on no server any more goes into the trash"
          }
        }
      }
    },
    "Im Projekt die [Gmail-API aktivieren ↗](https://console.cloud.google.com/apis/library/gmail.googleapis.com).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the project, [enable the Gmail API ↗](https://console.cloud.google.com/apis/library/gmail.googleapis.com)."
          }
        }
      }
    },
    "Import %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import %@"
          }
        }
      }
    },
    "Importieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
