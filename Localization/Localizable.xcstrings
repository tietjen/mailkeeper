          }
        }
      }
    },
    "Einschätzung korrigieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct the assessment"
          }
        }
      }
    },
    "Einschätzung korrigieren …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct the Assessment…"
          }
        }
      }
    },
    "Einstellungen › Konten › +. Es gibt IMAP, Gmail und die Proton Mail Bridge; vorhandene Archive liest du über Ablage › Importieren ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Accounts › +. There is IMAP, Gmail and the Proton Mail Bridge; existing archives come in via File › Import."
          }
        }
      }
    },
    "Einzelne .eml-Dateien": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Individual .eml files"
          }
        }
      }
    },
    "Embedding ohne Vektor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embedding without a vector"
          }
        }
      }
    },
    "Embedding-Antwort unvollständig": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embedding answer incomplete"
          }
        }
      }
    },
    "Embeddings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embeddings"
          }
        }
      }
    },
    "Embeddings (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embeddings (%@)"
          }
        }
      }
    },
    "Empfänger %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipient %@"
          }
        }
      }
    },
    "Endgültig löschen …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for Good…"
          }
        }
      }
    },
    "Endpoint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint"
          }
        }
      }
    },
    "Endpoint (OpenAI-kompatibel, z. B. LiteLLM, Ollama, LM Studio)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint (OpenAI-compatible, e.g. LiteLLM, Ollama, LM Studio)"
          }
        }
      }
    },
    "Endpoint meldet %lld: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Endpoint meldet %1$lld: %2$@"
          }
        },
